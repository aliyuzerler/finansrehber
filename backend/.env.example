# FinansRehber backend ortam değişkenleri
# Bu dosyayı .env olarak kopyala ve değerleri doldur:  cp .env.example .env
GEMINI_API_KEY=

# Web araması: Tavily birincil (tavily.com ücretsiz üyelik ~1.000 çağrı/ay),
# anahtar yoksa/kota biterse DDGS (DuckDuckGo) anahtarsız devreye girer.
TAVILY_API_KEY=

# Opsiyonel: farklı Gemini modeli (varsayılan gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

